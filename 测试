<?xml version="1.0" encoding="UTF-8"?>
<migration urlid="http://www.microsoft.com/migration/1.0/migxmlext/customexclude">

  <!-- Outlook 不迁移ost文件，Outlook跳过配置 -->
  <component type="Documents" context="User">
    <displayName>Perfect Outlook Migration Without Scripts</displayName>
    <role role="Data">
      <rules>
        <unconditionalExclude>
          <objectSet>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Microsoft\Outlook\ [*.ost]</pattern>
          </objectSet>
        </unconditionalExclude>
      </rules>
    </role>
    <role role="Settings">
      <rules>
        <addObjects>
          <object>
            <location type="Registry">HKCU\Software\Policies\Microsoft\Office\16.0\Outlook\AutoDiscover [ExcludeExplicitO365Endpoint]</location>
            <attributes>DWORD</attributes>
            <bytes>01000000</bytes>
          </object>
          <object>
            <location type="Registry">HKCU\Software\Policies\Microsoft\Office\16.0\Outlook\AutoDiscover [EnableSCPLookup]</location>
            <attributes>DWORD</attributes>
            <bytes>01000000</bytes>
          </object>
        </addObjects>
      </rules>
    </role>
  </component>

    <!-- 迁移自启动项 -->
  <component type="Application" context="User">
    <displayName>Migrate User Startup Registry Keys</displayName>
    <role role="Settings">
      <rules>
        <include>
          <objectSet>
            <pattern type="Registry">HKCU\Software\Microsoft\Windows\CurrentVersion\Run [*]</pattern>
            <pattern type="Registry">HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce [*]</pattern>
          </objectSet>
        </include>
      </rules>
    </role>
  </component>

  <!-- 交易及行情类客户端迁移 -->
  <component type="Documents" context="System">
    <displayName>迁移 C:\交易及行情类客户端</displayName>
    <role role="Data">
      <rules>
        <include>
          <objectSet>
            <pattern type="File">C:\交易及行情类客户端\* [*]</pattern>
          </objectSet>
        </include>
        <exclude>
          <object>
            <pattern type ="File">C:\交易及行情类客户端\* [*.log] </pattern>
          </object>
        </exclude>
      </rules>
    </role>
  </component>

  <!--  全盘包含（C盘所有文件和子目录）-->
  <component type="Documents" context="System">
    <displayName>Include all drives</displayName>
    <role role="Data">
      <rules>
        <include>
          <objectSet>
            <pattern type="File">C:\* [*]</pattern>
          </objectSet>
        </include>
      </rules>
    </role>
  </component>

    <!-- 排除D盘文件 -->
  <component type="Documents" context="System">
    <displayName>Exclude D Drive</displayName>
    <role role="Data">
      <rules>
        <unconditionalExclude>
          <objectSet>
            <pattern type="File">D:\* [*]</pattern>
            <pattern type="File">D:\*.*</pattern>
          </objectSet>
        </unconditionalExclude>
      </rules>
    </role>
  </component>

  <!-- 排除用户目录中AppData\Local指定文件夹 -->
  <component type="AppDataLocal" context="User">
    <displayName _locID="miguser.appdatalocal">AppData\Local</displayName>
    <role role="Data">
      <detects>
        <detect>
          <condition>MigXmlHelper.DoesObjectExist("File","%CSIDL_LOCAL_APPDATA%")</condition>
        </detect>
      </detects>
      <rules>
        <include filter='MigXmlHelper.IgnoreIrrelevantLinks()'>
          <objectSet>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\* [*]</pattern>
          </objectSet>
        </include>
        <exclude>
          <objectSet>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Microsoft\Windows\History\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Temp\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Citrix\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\VMware\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Adobe\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Packages\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Symantec\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Cyvera\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\anaconda3\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\ZOOMVDI\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Mozilla\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Programs\Python\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\CodeBuddyExtension\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Package Cache\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Google\Chrome\User Data\*\Cache\* [*]</pattern>
            <pattern type="File">%CSIDL_LOCAL_APPDATA%\Microsoft\Edge\User Data\*\Cache\* [*]</pattern>
          </objectSet>
        </exclude>
        <merge script="MigXmlHelper.DestinationPriority()">
          <objectSet>
            <pattern type="File">%CSIDL_LOCAL_APPDATA% [desktop.ini]</pattern>
          </objectSet>
        </merge>
      </rules>
    </role>
  </component>

