$softwareListUrl  = "$baseServerUrl/Microsoft%20Office%202019/install_software_list.csv"
$downloadPath     = "C:\tools"
$softwareFilePath = Join-Path -Path $downloadPath -ChildPath "software.csv"
$computerName     = $env:COMPUTERNAME

# 确保 C:\tools 目录存在
if (-not (Test-Path -Path $downloadPath)) {
    New-Item -Path $downloadPath -ItemType Directory -Force | Out-Null
}

# 下载 CSV 配置文件
$webClient = New-Object System.Net.WebClient
$webClient.DownloadFile($softwareListUrl, $softwareFilePath)

if (-not (Test-Path -Path $softwareFilePath)) {
    Write-Host "下载 CSV 清单失败，脚本退出！" -ForegroundColor Red
    exit
}

# 读取 CSV（-Encoding Default 可防止 Excel 保存的中文列名乱码）
$softwareList = Import-Csv -Path $softwareFilePath -Encoding Default
$currentComputer = $softwareList | Where-Object { $_.Computername -eq $computerName } | Select-Object -First 1

if (-not $currentComputer) {
    Write-Host "未在 CSV 中找到当前计算机 [$computerName] 的记录，脚本退出。" -ForegroundColor Yellow
    exit
}

# 下载文件函数
function New-Download-File {
    param (
        [string]$url
    )
    $fileName = [System.IO.Path]::GetFileName([uri]::UnescapeDataString($url))
    $filePath = Join-Path -Path $downloadPath -ChildPath $fileName
    Write-Host "正在下载: $fileName ..." -ForegroundColor Cyan
    $webClient.DownloadFile($url, $filePath)
    return $filePath
}

