# ==================== 3. 安装执行逻辑 ====================

# 3.1 单独处理 Adobe Acrobat (包含卸载旧版逻辑)
if ($currentComputer.AdobeAcrobat -eq "1") {
    Write-Host "开始处理: Adobe Acrobat ..." -ForegroundColor Green
    $refreshManager = Get-ItemProperty "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*" -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -eq "Adobe Refresh Manager" }
    if ($refreshManager) {
        Start-Process "msiexec.exe" -ArgumentList "/x $($refreshManager.PSChildName) /quiet /norestart" -Wait
    }
    $acrobat = Get-ItemProperty "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*" -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -eq "Adobe Acrobat (64-bit)" }
    if ($acrobat) {
        Start-Process "msiexec.exe" -ArgumentList "/x $($acrobat.PSChildName) /quiet /norestart" -Wait
    }
    
    $acrobatUrl = "$baseServerUrl/apps/CIFM-DT2022-005_Adobe%20Acrobat%20DC/AdobeAcrobat.zip"
    $zipPath = New-Download-File -url $acrobatUrl
    if (Test-Path $zipPath) {
        Expand-Archive -Path $zipPath -DestinationPath "C:\Tools" -Force
        Start-Process "C:\Tools\Adobe Acrobat\setup.exe" -ArgumentList "/sAll" -Wait
        Remove-Item "C:\Tools\Adobe Acrobat" -Recurse -Force -ErrorAction SilentlyContinue
        Remove-Item $zipPath -Force -ErrorAction SilentlyContinue
    }
}

# 3.2 循环处理其余所有软件
foreach ($app in $softwareCatalog) {
    $colName = $app.Column
    # 读取当前电脑在该列的值（支持 Notepad++ 等特殊字符列名）
    $val = $currentComputer.$colName

    if ($val -eq "1") {
        Write-Host "开始处理: $($app.Name) ..." -ForegroundColor Green
        $filePath = New-Download-File -url $app.Url

        if (Test-Path $filePath) {
            if ($app.Type -eq "EXE") {
                if ($app.Args) {
                    Start-Process -FilePath $filePath -ArgumentList $app.Args -Wait
                } else {
                    Start-Process -FilePath $filePath -Wait
                }
            }
            elseif ($app.Type -eq "MSI") {
                # MSI 必须通过 msiexec.exe 调用才能确保静默参数生效
                Start-Process -FilePath "msiexec.exe" -ArgumentList "/i `"$filePath`" $($app.Args) /norestart" -Wait
            }
            elseif ($app.Type -eq "ZIP") {
                # 确保解压目标文件夹存在
                if (-not (Test-Path -Path $app.Dest)) {
                    New-Item -Path $app.Dest -ItemType Directory -Force | Out-Null
                }
                Expand-Archive -Path $filePath -DestinationPath $app.Dest -Force
            }
            elseif ($app.Type -eq "PS1") {
                # PS1 脚本必须用 powershell.exe 调用，不能直接 Start-Process
                Start-Process -FilePath "powershell.exe" -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$filePath`"" -Wait
            }

            # 安装/解压完成后删除安装包
            Remove-Item -Path $filePath -Force -ErrorAction SilentlyContinue
        }
    }
}

