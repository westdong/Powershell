<?xml version="1.0" encoding="UTF-8"?>
<migration urlid="http://www.microsoft.com/migration/1.0/migxmlext/customexclude">

  <!-- ========== 全盘包含（C盘、D盘所有文件和子目录） ========== -->
  <component type="Documents" context="System">
    <displayName>Include all drives</displayName>
    <role role="Data">
      <rules>
        <include>
          <objectSet>
            <pattern type="File">C:\* [*]</pattern>
            <pattern type="File">D:\* [*]</pattern>
          </objectSet>
        </include>
      </rules>
    </role>
  </component>

  <!-- ========== 全局强制排除系统目录 ========== -->
  <component type="Documents" context="System">
    <displayName>Exclude system folders</displayName>
    <role role="Data">
      <rules>
        <unconditionalExclude>
          <objectSet>

            <!-- Windows 系统目录 -->
            <pattern type="File">C:\Windows\* [*]</pattern>
            <pattern type="File">C:\Windows.old\* [*]</pattern>

            <!-- Program Files -->
            <pattern type="File">C:\Program Files\* [*]</pattern>
            <pattern type="File">C:\Program Files (x86)\* [*]</pattern>

            <!-- ProgramData -->
            <pattern type="File">C:\ProgramData\* [*]</pattern>

            <!-- 用户 AppData（缓存/配置，通常不迁） -->
            <pattern type="File">C:\Users\* [AppData]</pattern>
            <pattern type="File">C:\Users\* [Local Settings]</pattern>

            <!-- 系统卷信息 / 恢复分区 -->
            <pattern type="File">C:\System Volume Information\* [*]</pattern>
            <pattern type="File">C:\Recovery\* [*]</pattern>

            <!-- 临时目录 -->
            <pattern type="File">C:\Temp\* [*]</pattern>
            <pattern type="File">C:\TMP\* [*]</pattern>

            <!-- 如果你有 EFI / Boot 分区挂载 -->
            <pattern type="File">C:\EFI\* [*]</pattern>
            <pattern type="File">C:\Boot\* [*]</pattern>

          </objectSet>
        </unconditionalExclude>
      </rules>
    </role>
  </component>

  <!-- ========== 用户文档（可选，确保用户数据被包含） ========== -->
  <component type="Documents" context="User">
    <displayName>Include user data</displayName>
    <role role="Data">
      <rules>
        <include>
          <objectSet>
            <pattern type="File">%USERPROFILE%\* [*]</pattern>
          </objectSet>
        </include>
        <!-- 排除用户目录下的 AppData -->
        <exclude>
          <objectSet>
            <pattern type="File">%USERPROFILE%\AppData\* [*]</pattern>
          </objectSet>
        </exclude>
      </rules>
    </role>
  </component>

</migration>
